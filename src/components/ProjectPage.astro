---
import Base from '../layouts/Base.astro'
import type { Project } from '../data/projects'
import type { Lang } from '../i18n/ui'
import { t } from '../i18n/ui'
import { glossary } from '../data/glossary'
import { params } from '../data/params'
import { methods } from '../data/methods'

interface Props {
  project: Project
  lang: Lang
}

const { project, lang } = Astro.props
const copy = t(lang)
const back = lang === 'zh' ? '/' : '/en/'
const langSwitchHref = lang === 'zh' ? `/en/projects/${project.slug}/` : `/projects/${project.slug}/`

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')

const terms = Object.keys(glossary).sort((a, b) => b.length - a.length)

const badge = (term: string) =>
  `${esc(term)}<span class="gl-i" role="note" aria-label="${esc(glossary[term][lang]).replace(/"/g, '&quot;')}" data-tip="${esc(glossary[term][lang]).replace(/"/g, '&quot;')}">?</span>`

/** 纯文本：术语首次出现处挂角标，其余字符转义 */
const tipifyText = (text: string) => {
  const out: string[] = []
  const used = new Set<string>()
  let i = 0
  while (i < text.length) {
    const hit = terms.find((t) => !used.has(t) && text.startsWith(t, i))
    if (hit) {
      out.push(badge(hit))
      used.add(hit)
      i += hit.length
    } else {
      out.push(esc(text[i]))
      i += 1
    }
  }
  return out.join('')
}

/** 给函数调用的实参挂可悬停解释；不认识的实参保持原样 */
const decorateCode = (codeHtml: string) =>
  codeHtml.replace(/<code>([\s\S]*?)<\/code>/g, (whole, inner: string) => {
    const call = /^([A-Za-z_$][\w$]*)\s*\(([\s\S]*)\)$/.exec(inner)
    if (!call) return whole
    const name = call[1]
    const nameTip = methods[name]?.[lang]
    const head = nameTip
      ? `<span class="p-i m-i" data-tip="${esc(nameTip).replace(/"/g, '&quot;')}">${esc(name)}</span>`
      : esc(name)
    const args = call[2].split(',').map((a) => {
      const arg = a.trim()
      const tip = params[arg]?.[lang]
      if (!tip) return esc(a)
      const at = a.indexOf(arg)
      const lead = esc(a.slice(0, at))
      const tail = esc(a.slice(at + arg.length))
      return `${lead}<span class="p-i" data-tip="${esc(tip).replace(/"/g, '&quot;')}">${esc(arg)}</span>${tail}`
    })
    return `<code>${head}(${args.join(',')})</code>`
  })

/** 含 `code` 的条目：code 段原样保留，不往里插术语角标；但实参可以挂参数解释 */
const tipify = (raw: string) => {
  const parts = raw.replace(/`([^`]+)`/g, '<code>$1</code>').split(/(<code>[\s\S]*?<\/code>)/)
  return parts.map((p, i) => (i % 2 === 1 ? decorateCode(p) : tipifyText(p))).join('')
}
---

<Base lang={lang} title={`${project.title[lang]} · ${copy.name}`} langSwitchHref={langSwitchHref}>
  <article class="project">
    <div class="wrap">
      <p><a href={back}>{copy.detailBack}</a></p>
      <h1>{project.title[lang]}</h1>
      <p class="sub">{project.subtitle[lang]}</p>

      {project.diagram && (
        <figure class="figure">
          <a class="shot-link" href={project.diagram}>
            <img src={project.diagram} alt={`${project.title[lang]} 架构示意`} loading="lazy" />
          </a>
        </figure>
      )}

      <dl class="dl">
        <dt>{copy.roleLabel}</dt>
        <dd>{project.role[lang]}</dd>
        {project.period && (
          <>
            <dt>{copy.periodLabel}</dt>
            <dd>{project.period}</dd>
          </>
        )}
        <dt>{copy.stackLabel}</dt>
        <dd>{project.stack.join(' · ')}</dd>
        {project.repo && (
          <>
            <dt>{copy.repoLabel}</dt>
            <dd><a href={project.repo}>{project.repo.replace('https://', '')}</a></dd>
          </>
        )}
      </dl>

      <h2>{copy.problemLabel}</h2>
      <p>{project.problem[lang]}</p>

      <h2>{copy.actionLabel}</h2>
      <ul>
        {project.action[lang].map((a, i) => {
          const note = project.notes?.[lang]?.[i]
          return (
            <li>
              <span set:html={a.replace(/`([^`]+)`/g, '<code>$1</code>')} />
              {note && (
                <button class="note-btn" type="button" data-note={tipify(note)} aria-label={copy.noteLabel}>i</button>
              )}
            </li>
          )
        })}
      </ul>

      <h2>{copy.resultLabel}</h2>
      <ul>
        {project.result[lang].map((r) => <li set:html={r.replace(/`([^`]+)`/g, '<code>$1</code>')} />)}
      </ul>

      {project.shots && (
        <>
          <h2>{copy.shotsLabel}</h2>
          <div class="gallery">
            {project.shots.map((s) => (
              <figure>
                <a class="shot-link" href={s.src}>
                  <img src={s.src} alt={s.caption[lang]} decoding="async" />
                </a>
                <figcaption>{s.caption[lang]}</figcaption>
              </figure>
            ))}
          </div>
        </>
      )}

      <dialog id="lightbox" class="lightbox">
        <button class="lb-close" type="button" aria-label={copy.lightboxClose}>×</button>
        <img alt="" />
      </dialog>

      <dialog id="note" class="note-dialog">
        <div class="note-head">
          <button class="note-close" type="button" aria-label={copy.lightboxClose}>×</button>
        </div>
        <p class="note-body"></p>
      </dialog>

      <script is:inline>
        (() => {
          const init = () => {
            const lb = document.getElementById('lightbox')
            if (!lb) return
            const big = lb.querySelector('img')
            // 滚轮二次缩放：以鼠标位置为锚点，1 倍 = 铺满视口的初始尺寸
            let zoom = 1
            let tx = 0
            let ty = 0
            let cx = 0
            let cy = 0
            const applyZoom = () => {
              big.style.transform = zoom === 1 && tx === 0 && ty === 0 ? '' : `translate(${tx}px, ${ty}px) scale(${zoom})`
            }
            const resetZoom = () => {
              zoom = 1
              tx = 0
              ty = 0
              applyZoom()
            }
            lb.addEventListener('close', resetZoom)
            big.addEventListener(
              'wheel',
              (e) => {
                e.preventDefault()
                if (zoom === 1) {
                  const r = big.getBoundingClientRect()
                  cx = r.left + r.width / 2
                  cy = r.top + r.height / 2
                }
                const step = e.deltaY < 0 ? 1.15 : 1 / 1.15
                const next = Math.min(6, Math.max(1, zoom * step))
                if (next === zoom) return
                const ux = e.clientX - cx
                const uy = e.clientY - cy
                const k = next / zoom
                tx = ux - k * (ux - tx)
                ty = uy - k * (uy - ty)
                zoom = next
                if (zoom === 1) {
                  tx = 0
                  ty = 0
                }
                applyZoom()
              },
              { passive: false },
            )
            const note = document.getElementById('note')
            const noteBody = note && note.querySelector('.note-body')
            const tip = document.createElement('div')
            tip.className = 'gl-tip'
            document.body.appendChild(tip)
            let tipTarget = null
            let hideTimer = null
            const cancelHide = () => {
              if (hideTimer) {
                clearTimeout(hideTimer)
                hideTimer = null
              }
            }
            const scheduleHide = () => {
              cancelHide()
              // 问号和浮窗之间有几像素空隙，留一点时间让指针走过去
              hideTimer = setTimeout(() => hideTip(), 160)
            }
            const showTip = (el) => {
              const text = el.getAttribute('data-tip')
              if (!text) return
              // 对话框在 top layer，body 里的浮层会被盖住，所以打开时把浮层挂进对话框内
              const host = note && note.open ? note : lb.open ? lb : document.body
              if (tip.parentElement !== host) host.appendChild(tip)
              tip.textContent = text
              tip.style.left = '0px'
              tip.style.top = '0px'
              tip.classList.add('on')
              const r = el.getBoundingClientRect()
              const tr = tip.getBoundingClientRect()
              const x = Math.max(10, Math.min(r.left + r.width / 2 - tr.width / 2, innerWidth - tr.width - 10))
              let y = r.top - tr.height - 8
              if (y < 8) y = r.bottom + 8
              tip.style.left = `${Math.round(x)}px`
              tip.style.top = `${Math.round(y)}px`
              tipTarget = el
            }
            const hideTip = () => {
              cancelHide()
              tip.classList.remove('on')
              tipTarget = null
            }
            document.addEventListener('mouseover', (e) => {
              const t2 = e.target
              if (t2 === tip) {
                cancelHide()
                return
              }
              const el = t2 instanceof Element ? t2.closest('[data-tip]') : null
              if (el) {
                cancelHide()
                if (el !== tipTarget) showTip(el)
              }
            })
            document.addEventListener('mouseout', (e) => {
              const t2 = e.target
              const el = t2 instanceof Element ? t2.closest('[data-tip]') : null
              if ((el && el === tipTarget) || t2 === tip) scheduleHide()
            })
            document.addEventListener('click', (e) => {
              const t = e.target
              const btn = t instanceof Element ? t.closest('.note-btn') : null
              if (btn && note && noteBody) {
                e.preventDefault()
                noteBody.innerHTML = btn.getAttribute('data-note') || ''
                if (!note.open) note.showModal()
                return
              }
              const link = t instanceof Element ? t.closest('.shot-link') : null
              if (link) {
                e.preventDefault()
                big.src = link.getAttribute('href')
                resetZoom()
                if (!lb.open) lb.showModal()
                return
              }
              if (note && note.open && t instanceof Element && t.closest('.note-close')) {
                note.close()
                return
              }
              if (!lb.open) return
              if (t instanceof Element && t.closest('.lb-close')) {
                lb.close()
                return
              }
              if (e.detail > 1) return
              if (t === lb || t === big) lb.close()
            })
            // 遮罩点击关闭：只有 target 是 dialog 本身、且落点在其矩形之外才算点到了遮罩。
            // 不能用「点正文就关」——拖选文字结束时浏览器也会派发一次 click，会误关。
            if (note) {
              note.addEventListener('click', (e) => {
                if (e.target !== note) return
                const r = note.getBoundingClientRect()
                if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) {
                  note.close()
                }
              })
            }
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init)
          } else {
            init()
          }
        })()
      </script>

      {project.repo && (
        <p style="margin-top:32px"><a href={project.repo}>{copy.repoLink}</a></p>
      )}
    </div>
  </article>
</Base>
