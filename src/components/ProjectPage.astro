---
import Base from '../layouts/Base.astro'
import type { Project } from '../data/projects'
import type { Lang } from '../i18n/ui'
import { t } from '../i18n/ui'

interface Props {
  project: Project
  lang: Lang
}

const { project, lang } = Astro.props
const copy = t(lang)
const back = lang === 'zh' ? '/' : '/en/'
const langSwitchHref = lang === 'zh' ? `/en/projects/${project.slug}/` : `/projects/${project.slug}/`
---

<Base lang={lang} title={`${project.title[lang]} · ${copy.name}`} langSwitchHref={langSwitchHref}>
  <article class="project">
    <div class="wrap">
      <p><a href={back}>{copy.detailBack}</a></p>
      <h1>{project.title[lang]}</h1>
      <p class="sub">{project.subtitle[lang]}</p>

      {project.diagram && (
        <figure class="figure">
          <a class="shot-link" href={project.diagram}>
            <img src={project.diagram} alt={`${project.title[lang]} 架构示意`} loading="lazy" />
          </a>
        </figure>
      )}

      <dl class="dl">
        <dt>{copy.roleLabel}</dt>
        <dd>{project.role[lang]}</dd>
        {project.period && (
          <>
            <dt>{copy.periodLabel}</dt>
            <dd>{project.period}</dd>
          </>
        )}
        <dt>{copy.stackLabel}</dt>
        <dd>{project.stack.join(' · ')}</dd>
        {project.repo && (
          <>
            <dt>{copy.repoLabel}</dt>
            <dd><a href={project.repo}>{project.repo.replace('https://', '')}</a></dd>
          </>
        )}
      </dl>

      <h2>{copy.problemLabel}</h2>
      <p>{project.problem[lang]}</p>

      <h2>{copy.actionLabel}</h2>
      <ul>
        {project.action[lang].map((a, i) => {
          const note = project.notes?.[lang]?.[i]
          return (
            <li>
              <span set:html={a.replace(/`([^`]+)`/g, '<code>$1</code>')} />
              {note && (
                <button class="note-btn" type="button" data-note={note} aria-label={copy.noteLabel}>i</button>
              )}
            </li>
          )
        })}
      </ul>

      <h2>{copy.resultLabel}</h2>
      <ul>
        {project.result[lang].map((r) => <li set:html={r.replace(/`([^`]+)`/g, '<code>$1</code>')} />)}
      </ul>

      {project.shots && (
        <>
          <h2>{copy.shotsLabel}</h2>
          <div class="gallery">
            {project.shots.map((s) => (
              <figure>
                <a class="shot-link" href={s.src}>
                  <img src={s.src} alt={s.caption[lang]} decoding="async" />
                </a>
                <figcaption>{s.caption[lang]}</figcaption>
              </figure>
            ))}
          </div>
        </>
      )}

      <dialog id="lightbox" class="lightbox">
        <button class="lb-close" type="button" aria-label={copy.lightboxClose}>×</button>
        <img alt="" />
      </dialog>

      <dialog id="note" class="note-dialog">
        <button class="note-close" type="button" aria-label={copy.lightboxClose}>×</button>
        <p class="note-body"></p>
      </dialog>

      <script is:inline>
        (() => {
          const init = () => {
            const lb = document.getElementById('lightbox')
            if (!lb) return
            const big = lb.querySelector('img')
            const note = document.getElementById('note')
            const noteBody = note && note.querySelector('.note-body')
            document.addEventListener('click', (e) => {
              const t = e.target
              const btn = t instanceof Element ? t.closest('.note-btn') : null
              if (btn && note && noteBody) {
                e.preventDefault()
                noteBody.textContent = btn.getAttribute('data-note') || ''
                if (!note.open) note.showModal()
                return
              }
              const link = t instanceof Element ? t.closest('.shot-link') : null
              if (link) {
                e.preventDefault()
                big.src = link.getAttribute('href')
                if (!lb.open) lb.showModal()
                return
              }
              if (note && note.open) {
                if (t instanceof Element && t.closest('.note-close')) {
                  note.close()
                  return
                }
                if (e.detail > 1) return
                if (t === note || t === noteBody) note.close()
                return
              }
              if (!lb.open) return
              if (t instanceof Element && t.closest('.lb-close')) {
                lb.close()
                return
              }
              if (e.detail > 1) return
              if (t === lb || t === big) lb.close()
            })
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init)
          } else {
            init()
          }
        })()
      </script>

      {project.repo && (
        <p style="margin-top:32px"><a href={project.repo}>{copy.repoLink}</a></p>
      )}
    </div>
  </article>
</Base>
