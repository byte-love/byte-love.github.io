---
import Base from '../layouts/Base.astro'
import ProjectCard from './ProjectCard.astro'
import ProjectIndex from './ProjectIndex.astro'
import { projects } from '../data/projects'
import { diy } from '../data/diy'
import type { Lang } from '../i18n/ui'
import { t } from '../i18n/ui'

interface Props {
  lang: Lang
  langSwitchHref: string
}

const { lang, langSwitchHref } = Astro.props
const copy = t(lang)
// 只渲染真正的 DIY 条目；占位（slug 以 todo- 开头）算没有内容，整块连同导航一起隐藏
const diyItems = diy.filter((d) => !d.slug.startsWith('todo-'))
// 实习项目与个人项目分两块渲染：前者有脱敏说明，后者没有
const internshipProjects = projects.filter((p) => (p.category ?? 'internship') === 'internship')
const personalProjects = projects.filter((p) => p.category === 'personal')
---

<Base
  lang={lang}
  title={lang === 'zh' ? '项目 · byte-love' : 'Projects · byte-love'}
  langSwitchHref={langSwitchHref}
  showDiy={diyItems.length > 0}
>
  <div class="wrap">
    <section class="hero">
      <h1>{copy.heroTitle}</h1>
      <p class="lead">{copy.heroLead}</p>
      <p class="meta">
        {copy.heroMeta.map((m) => <span>{m}</span>)}
      </p>
    </section>
  </div>

  <section class="block" id="projects">
    <div class="wrap">
      <div class="projects-layout" data-projects-root data-lang={lang}
           data-label-projects={copy.sectionProjects} data-label-personal={copy.sectionPersonal}>
        <ProjectIndex internship={internshipProjects} personal={personalProjects} lang={lang} />

        <div class="projects-main">
          <h2>{copy.sectionProjects}</h2>
          <p class="section-note">{copy.projectsNote}</p>
          <div class="list">
            {internshipProjects.map((p) => <ProjectCard project={p} lang={lang} />)}
          </div>

          {personalProjects.length > 0 && (
            <>
              <h2 id="personal" class="group-head">{copy.sectionPersonal}</h2>
              <div class="list">
                {personalProjects.map((p) => <ProjectCard project={p} lang={lang} />)}
              </div>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  {diyItems.length > 0 && (
  <section class="block" id="diy">
    <div class="wrap">
      <h2>{copy.sectionDiy}</h2>
      <div class="diy-grid">
        {
          diyItems.map((d) => (
            <article class="diy">
              {d.image ? <img class="shot-img" src={d.image} alt={d.title[lang]} /> : null}
              <h3>{d.title[lang]}</h3>
              <p>{d.desc[lang]}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  )}

  <section class="block" id="about">
    <div class="wrap">
      <h2>{copy.sectionAbout}</h2>
      <p class="lead">{copy.aboutText}</p>
      <p class="meta">
        <span><a href={`mailto:${copy.email}`}>{copy.email}</a></span>
        <span><a href="https://github.com/byte-love">GitHub</a></span>
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  // 项目现在存在后端数据库里，页面先用构建时的数据渲染一版，
  // 拿到接口数据后再重绘，这样改库即刻生效、不用重新构建。
  (() => {
    const root = document.querySelector('[data-projects-root]')
    if (!root) return

    const lang = root.dataset.lang || 'zh'
    const labelProjects = root.dataset.labelProjects || ''
    const labelPersonal = root.dataset.labelPersonal || ''

    const esc = (s) =>
      String(s == null ? '' : s).replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]
      )
    const pick = (v) =>
      v == null ? '' : typeof v === 'string' ? v : v[lang] || v.zh || v.en || ''
    const arr = (v) =>
      Array.isArray(v) ? v : v && typeof v === 'object' ? v[lang] || v.zh || v.en || [] : []

    const cardHtml = (p) => {
      const stack = Array.isArray(p.stack) ? p.stack.join(' · ') : ''
      const first = arr(p.result)[0] || ''
      return (
        '<a class="card" id="' + esc(p.slug) + '" href="/app/projects/' + esc(p.slug) + '">' +
        '<div class="row1"><h3>' + esc(pick(p.title)) + '</h3>' +
        '<span class="role">' + esc(pick(p.role)) + '</span></div>' +
        '<p class="problem">' + esc(pick(p.subtitle)) + '</p>' +
        '<p class="result">' + esc(first) + '</p>' +
        '<p class="stack">' + esc(stack) + '</p></a>'
      )
    }

    const groupHtml = (key, label, list) =>
      '<div class="index-group"><button type="button" class="group-btn" data-key="' + key + '">' +
      esc(label) + '<span class="count">' + list.length + '</span></button><ul class="index-tree">' +
      list
        .map((p) => '<li><a href="#' + esc(p.slug) + '">' + esc(pick(p.short) || pick(p.title)) + '</a></li>')
        .join('') +
      '</ul></div>'

    const paint = (list) => {
      const internship = list.filter((p) => (p.category || 'internship') === 'internship')
      const personal = list.filter((p) => p.category === 'personal')

      const index = root.querySelector('.project-index')
      if (index) {
        index.innerHTML =
          (internship.length ? groupHtml('internship', labelProjects, internship) : '') +
          (personal.length ? groupHtml('personal', labelPersonal, personal) : '')
      }

      const lists = root.querySelectorAll('.projects-main .list')
      if (lists[0]) lists[0].innerHTML = internship.map(cardHtml).join('')
      if (lists[1]) lists[1].innerHTML = personal.map(cardHtml).join('')

      if (window.__initProjectIndex) window.__initProjectIndex()
    }

    fetch('/app/api/projects', { headers: { Accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (Array.isArray(data) && data.length) paint(data)
      })
      .catch(() => {})
  })()
</script>
