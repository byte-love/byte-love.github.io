---
import '../styles/global.css'
import type { Lang } from '../i18n/ui'
import { t } from '../i18n/ui'

interface Props {
  lang: Lang
  title: string
  langSwitchHref: string
  showDiy?: boolean
}

const { lang, title, langSwitchHref, showDiy = true } = Astro.props
const copy = t(lang)
const home = copy.homeHref
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={copy.heroLead} />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme')
          if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={home}>{copy.name}</a>
        <nav class="top">
          <a href={`${home}#projects`}>{copy.navProjects}</a>
          {showDiy && <a href={`${home}#diy`}>{copy.navDiy}</a>}
          <a href={`${home}#about`}>{copy.navAbout}</a>
          <a class="lang-switch" href={langSwitchHref}>{copy.langSwitch}</a>
          <button class="theme-toggle" type="button" aria-label={copy.themeToggle}>☀</button>
        </nav>
      </div>
    </header>

    <script is:inline>
      (() => {
        const btn = document.querySelector('.theme-toggle')
        if (!btn) return
        const mq = window.matchMedia('(prefers-color-scheme: dark)')
        const current = () => document.documentElement.dataset.theme || (mq.matches ? 'dark' : 'light')
        const sync = () => {
          btn.textContent = current() === 'dark' ? '☀' : '☾'
        }
        sync()
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark'
          document.documentElement.dataset.theme = next
          try {
            localStorage.setItem('theme', next)
          } catch (e) {}
          sync()
        })
        mq.addEventListener('change', sync)
      })()
    </script>

    <main>
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <a href={`mailto:${copy.email}`}>{copy.email}</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/byte-love">github.com/byte-love</a>
      </div>
    </footer>
  </body>
</html>
