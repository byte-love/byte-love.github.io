---
import '../styles/global.css'
import type { Lang } from '../i18n/ui'
import { t } from '../i18n/ui'

interface Props {
  lang: Lang
  title: string
  langSwitchHref: string
  showDiy?: boolean
}

const { lang, title, langSwitchHref, showDiy = true } = Astro.props
const copy = t(lang)
const home = copy.homeHref
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={copy.heroLead} />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme')
          if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={home}>{copy.brand}</a>
        <nav class="tabs" aria-label={copy.tabNavLabel}>
          <a class="tab is-active" href={home} aria-current="page" data-spy="projects">{copy.tabProjects}</a>
          <a class="tab" href={copy.notesHref}>{copy.tabNotes}</a>
          <a class="tab" href={`${home}#about`} data-spy="about">{copy.tabAbout}</a>
        </nav>
        <div class="header-tools">
          <span class="auth-slot" data-auth></span>
          <a class="lang-switch" href={langSwitchHref}>{copy.langSwitch}</a>
          <button class="theme-toggle" type="button" aria-label={copy.themeToggle}>☀</button>
        </div>
      </div>
    </header>

    <script is:inline>
      (() => {
        const btn = document.querySelector('.theme-toggle')
        if (!btn) return
        const mq = window.matchMedia('(prefers-color-scheme: dark)')
        const current = () => document.documentElement.dataset.theme || (mq.matches ? 'dark' : 'light')
        const sync = () => {
          btn.textContent = current() === 'dark' ? '☀' : '☾'
        }
        sync()
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark'
          document.documentElement.dataset.theme = next
          try {
            localStorage.setItem('theme', next)
          } catch (e) {}
          sync()
        })
        mq.addEventListener('change', sync)
      })()
    </script>

    <script is:inline>
      (() => {
        const slot = document.querySelector('[data-auth]')
        if (!slot) return
        const render = (state) => {
          slot.textContent = ''
          if (!state.authenticated) {
            const a = document.createElement('a')
            a.href = state.loginUrl
            a.textContent = '登录'
            slot.appendChild(a)
            return
          }
          if (state.owner) {
            const admin = document.createElement('a')
            admin.href = state.adminUrl
            admin.textContent = '后台'
            slot.appendChild(admin)
          }
          const out = document.createElement('button')
          out.type = 'button'
          out.className = 'link-button'
          out.textContent = '退出'
          out.addEventListener('click', async () => {
            const headers = {}
            if (state.csrfHeader && state.csrfToken) headers[state.csrfHeader] = state.csrfToken
            try {
              await fetch(state.logoutUrl, { method: 'POST', headers, credentials: 'same-origin' })
            } catch (e) {}
            location.reload()
          })
          slot.appendChild(out)
        }
        fetch('/app/api/me', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then((r) => (r.ok ? r.json() : null))
          .then((state) => state && render(state))
          .catch(() => {})
      })()
    </script>

    <script is:inline>
      (() => {
        const about = document.querySelector('#about')
        if (!about) return
        const tabs = [...document.querySelectorAll('nav.tabs .tab[data-spy]')]
        if (!tabs.length) return
        const pick = (name) => tabs.find((t) => t.dataset.spy === name)
        const sync = () => {
          const active = window.scrollY + 120 >= about.offsetTop ? pick('about') : pick('projects')
          for (const t of tabs) t.classList.toggle('is-active', t === active)
        }
        window.addEventListener('scroll', sync, { passive: true })
        window.addEventListener('resize', sync)
        sync()
      })()
    </script>

    <main>
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <a href={`mailto:${copy.email}`}>{copy.email}</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/byte-love">github.com/byte-love</a>
      </div>
    </footer>
  </body>
</html>
